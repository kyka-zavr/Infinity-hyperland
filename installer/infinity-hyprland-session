#!/bin/sh
# Запуск сессии Infinity-hyprland из экрана входа (SDDM, GDM, greetd и других).
# Используется ТОЛЬКО свой каталог конфигов, ~/.config/hypr оригинального Hyprland не читается и не меняется.

PREFIX="${INFINITY_HYPRLAND_PREFIX:-@PREFIX@}"
BIN="${INFINITY_HYPRLAND_BIN:-$PREFIX/bin/InfinityHyprland}"
START="${INFINITY_HYPRLAND_START:-$PREFIX/bin/start-hyprland}"
CONFIG_TOOL="${INFINITY_HYPRLAND_CONFIG_TOOL:-$PREFIX/bin/infinity-hyprland-config}"
CONFDIR="${INFINITY_HYPRLAND_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/infinity-hyprland}"

# порталы и приложения, которые ждут "Hyprland", продолжают работать
export XDG_CURRENT_DESKTOP="Infinity-hyprland:Hyprland"
export XDG_SESSION_DESKTOP="Infinity-hyprland"
export XDG_SESSION_TYPE="wayland"

if [ -z "$HYPRLAND_CONFIG" ]; then
    if [ -f "$CONFDIR/hyprland.lua" ]; then
        HYPRLAND_CONFIG="$CONFDIR/hyprland.lua"
    fi
fi

# конфига ещё нет (установщик не запускали для этого пользователя): создаём стандартный, ничего чужого не трогая
if [ -z "$HYPRLAND_CONFIG" ] && [ -x "$CONFIG_TOOL" ]; then
    INFINITY_HYPRLAND_CONFIG_DIR="$CONFDIR" "$CONFIG_TOOL" fresh --quiet
    [ -f "$CONFDIR/hyprland.lua" ] && HYPRLAND_CONFIG="$CONFDIR/hyprland.lua"
fi

[ -n "$HYPRLAND_CONFIG" ] && export HYPRLAND_CONFIG

# бинды, раскладки и цвета форка генерируются из настроек: обновляем перед запуском
SETTINGS="${INFINITY_HYPRLAND_SETTINGS:-$PREFIX/bin/infinity-settings}"
if [ -x "$SETTINGS" ]; then
    INFINITY_HYPRLAND_CONFIG_DIR="$CONFDIR" "$SETTINGS" --init >/dev/null 2>&1
    INFINITY_HYPRLAND_CONFIG_DIR="$CONFDIR" "$SETTINGS" --apply --no-reload >/dev/null 2>&1
fi

# Библиотеки Hyprland, с которыми собран композитор, лежат в $PREFIX/lib (их кладёт install.sh):
# обновление системных aquamarine, hyprutils и других не ломает запуск.
LIBDIR="$PREFIX/lib"
[ -d "$LIBDIR" ] && export LD_LIBRARY_PATH="$LIBDIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Проверка перед стартом: если композитор всё же не запустится (нет файла или библиотеки, например после
# обновления mesa или wayland), входим в обычный Hyprland, а не возвращаемся на экран входа.
broken=""
if [ ! -x "$BIN" ]; then
    broken="нет файла $BIN"
elif command -v ldd >/dev/null 2>&1; then
    missing="$(ldd "$BIN" 2>/dev/null | sed -n 's/^[[:space:]]*\(.*\) => not found.*/\1/p' | tr '\n' ' ')"
    [ -n "$missing" ] && broken="не найдены библиотеки: $missing"
fi
if [ -n "$broken" ]; then
    MSG="Infinity-hyprland не запущен ($broken). Запущен обычный Hyprland; пересоберите форк: ./install.sh"
    echo "$MSG" >&2
    mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}" 2>/dev/null
    echo "$(date -Iseconds) $MSG" >> "${XDG_STATE_HOME:-$HOME/.local/state}/infinity-hyprland-fallback.log" 2>/dev/null
    export XDG_CURRENT_DESKTOP="Hyprland" XDG_SESSION_DESKTOP="Hyprland"
    unset HYPRLAND_CONFIG LD_LIBRARY_PATH
    # уведомление покажется, как только поднимется демон уведомлений обычного Hyprland
    ( sleep 8; command -v notify-send >/dev/null 2>&1 && notify-send -u critical "Infinity-hyprland" "$MSG" ) >/dev/null 2>&1 &
    if command -v start-hyprland >/dev/null 2>&1; then exec start-hyprland; fi
    if command -v Hyprland >/dev/null 2>&1; then exec Hyprland; fi
    exit 1
fi

# раз в 6 часов смотрим, не вышел ли новый релиз, и показываем уведомление (живёт, пока жива сессия)
UPDATER="$PREFIX/bin/infinity-update"
[ -x "$UPDATER" ] && ( setsid "$UPDATER" loop --pid "$$" >/dev/null 2>&1 & )

# start-hyprland перезапускает композитор в безопасном режиме после сбоя
if [ -x "$START" ]; then
    exec "$START" --path "$BIN"
fi
exec "$BIN"
