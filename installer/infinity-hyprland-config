#!/usr/bin/env bash
# Управление конфигом Infinity-hyprland. Работает только с ~/.config/infinity-hyprland (или INFINITY_HYPRLAND_CONFIG_DIR),
# ~/.config/hypr оригинального Hyprland ТОЛЬКО читается (в режиме copy-hyprland) и никогда не меняется.
#
#   infinity-hyprland-config fresh [--force] [--quiet]
#       создаёт стандартный конфиг из примера (с бинами Infinity)
#   infinity-hyprland-config copy-hyprland [--from DIR] [--force] [--quiet]
#       копирует в свой каталог конфиг Hyprland (hyprland.lua) (главный файл и файлы, на которые он ссылается) и добавляет бинды Infinity
#   infinity-hyprland-config migrate
#       переводит конфиг со старым блоком бинд Infinity на настройки (клавиши переносятся)
#   infinity-hyprland-config status
set -euo pipefail

PREFIX="${INFINITY_HYPRLAND_PREFIX:-@PREFIX@}"
SHARE="${INFINITY_HYPRLAND_SHARE:-$PREFIX/share/infinity-hyprland}"
EXAMPLE="${INFINITY_HYPRLAND_EXAMPLE:-$PREFIX/share/hypr/hyprland.lua}"
DEST="${INFINITY_HYPRLAND_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/infinity-hyprland}"
SRC_DEFAULT="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
MARK='>>> infinity-hyprland'

quiet=0; force=0; src="$SRC_DEFAULT"
say() { [[ $quiet -eq 1 ]] || printf '%s\n' "$*"; }
die() { printf 'infinity-hyprland-config: %s\n' "$*" >&2; exit 1; }

main_config() { # <каталог> -> путь к hyprland.lua (Hyprland 0.57+ читает только Lua-конфиг)
    [[ -f "$1/hyprland.lua" ]] && { printf '%s' "$1/hyprland.lua"; return 0; }
    return 1
}

# существующий конфиг не трогаем: либо отказ, либо (с --force) резервная копия рядом
guard_existing() {
    if existing=$(main_config "$DEST"); then
        [[ $force -eq 1 ]] || die "в $DEST уже есть конфиг ($(basename "$existing")), ничего не перезаписано (--force сделает резервную копию и заменит)"
        local bak="$DEST.bak-$(date +%Y%m%d-%H%M%S)"
        cp -a "$DEST" "$bak"
        say "Резервная копия: $bak"
    fi
}

append_binds() { # <главный файл>
    local f="$1" snippet="$SHARE/infinity-include.lua"
    [[ -f "$snippet" ]] || die "нет файла $snippet"
    if grep -q "$MARK" "$f"; then say "Подключение Infinity уже есть в $(basename "$f")"; return; fi
    { printf '\n'; cat "$snippet"; } >> "$f"
}

# настройки и сгенерированный infinity.lua (бинды, раскладки, цвета)
init_settings() {
    local tool="${INFINITY_HYPRLAND_SETTINGS:-$PREFIX/bin/infinity-settings}"
    [[ -x "$tool" ]] || return 0
    INFINITY_HYPRLAND_CONFIG_DIR="$DEST" "$tool" --init >/dev/null 2>&1 || true
    INFINITY_HYPRLAND_CONFIG_DIR="$DEST" "$tool" --apply --no-reload >/dev/null 2>&1 || true
}

cmd_fresh() {
    guard_existing
    [[ -f "$EXAMPLE" ]] || die "нет примера конфига: $EXAMPLE"
    mkdir -p "$DEST"
    cp "$EXAMPLE" "$DEST/hyprland.lua"
    init_settings
    say "Создан $DEST/hyprland.lua (бинды, раскладки и цвета Infinity берутся из настроек, SUPER+I)"
}

cmd_copy() {
    [[ -d "$src" ]] || die "нет каталога с конфигом Hyprland: $src"
    local main
    if ! main=$(main_config "$src"); then
        [[ -f "$src/hyprland.conf" ]] && die "в $src только hyprland.conf: Hyprland 0.57 читает конфиг только в формате Lua (hyprland.lua), перенесите конфиг на Lua или используйте режим fresh"
        die "в $src нет hyprland.lua"
    fi
    guard_existing
    mkdir -p "$DEST"

    # главный файл и всё, на что он ссылается внутри каталога конфига (source, require, dofile, пути с ~/.config/hypr)
    local -a queue=("$main") copied=()
    local f rel ref cand
    while ((${#queue[@]})); do
        f="${queue[0]}"; queue=("${queue[@]:1}")
        rel="${f#"$src"/}"
        [[ " ${copied[*]-} " == *" $rel "* ]] && continue
        mkdir -p "$DEST/$(dirname "$rel")"
        cp "$f" "$DEST/$rel"
        copied+=("$rel")

        while IFS= read -r ref; do
            ref="${ref#"$src"/}"; [[ "$ref" == *.config/hypr/* ]] && ref="${ref#*.config/hypr/}"; ref="${ref#./}"
            for cand in "$ref" "$ref.lua" "$ref.conf" "$(dirname "$rel")/$ref"; do
                if [[ -f "$src/$cand" && "$cand" != /* && "$cand" != *..* ]]; then queue+=("$src/$cand"); break; fi
            done
        done < <(grep -oE '[A-Za-z0-9_./~${}-]+(\.lua|\.conf)?' "$f" | sort -u)
    done

    # внутри копии ссылки на скопированные файлы ведут в новый каталог, а не в каталог оригинала
    local c old
    for c in "${copied[@]}"; do
        for old in "~/.config/hypr" "\$HOME/.config/hypr" "\${HOME}/.config/hypr" "$src"; do
            for f in "${copied[@]}"; do
                sed -i "s|${old//|/\\|}/${f//|/\\|}|$DEST/${f//|/\\|}|g" "$DEST/$c"
            done
        done
        # Lua: os.getenv("HOME") .. "/.config/hypr/файл"  ->  "<новый каталог>/файл"
        for f in "${copied[@]}"; do
            fe="${f//./\\.}"
            sed -i -E "s#os\.getenv\(\"HOME\"\) *\.\. *\"/\.config/hypr/${fe//#/\\#}\"#\"${DEST//#/\\#}/${f//#/\\#}\"#g" "$DEST/$c"
        done
    done

    append_binds "$DEST/${main#"$src"/}"
    init_settings
    say "Скопировано из $src в $DEST: ${copied[*]}"
    say "Оригинал не изменён. Другие файлы Hyprland (hyprlock, hypridle, hyprpaper и т.д.) читаются своими программами из ~/.config/hypr как раньше."
}

# старый блок с бинды (hl.bind внутри >>> infinity-hyprland) -> подключение сгенерированного файла;
# клавиши, которые вы меняли, переносятся в settings.json
cmd_migrate() {
    local main; main=$(main_config "$DEST") || die "в $DEST нет конфига"
    grep -q "$MARK" "$main" || { say "Нечего переносить: блока Infinity в $(basename "$main") нет"; return 0; }
    sed -n "/$MARK/,/<<< infinity-hyprland/p" "$main" | grep -q 'hl\.bind' || { say "Блок уже нового вида"; init_settings; return 0; }
    command -v python3 >/dev/null || die "для переноса нужен python3"

    local tool="${INFINITY_HYPRLAND_SETTINGS:-$PREFIX/bin/infinity-settings}"
    local bak="$main.bak-$(date +%Y%m%d-%H%M%S)"
    cp -a "$main" "$bak"

    local keys_json
    keys_json=$(python3 - "$main" "$SHARE/infinity-include.lua" <<'PY'
import json, re, sys
path, include = sys.argv[1], sys.argv[2]
text = open(path).read()
start = text.index(">>> infinity-hyprland")
start = text.rfind("\n", 0, start) + 1
end_marker = "<<< infinity-hyprland"
end = text.index(end_marker)
end = text.index("\n", end) + 1 if "\n" in text[end:] else len(text)
block = text[start:end]

ids = {"infinity toggle": "infinity_toggle", "alttab": "switcher_next", "alttab prev": "switcher_prev", "kblayout next": "layout_next",
       "infinity pan 150 0": "pan_left", "infinity pan -150 0": "pan_right", "infinity pan 0 150": "pan_up", "infinity pan 0 -150": "pan_down",
       "infinity zoom 1.25": "zoom_in", "infinity zoom 0.8": "zoom_out"}
keys = {}
for m in re.finditer(r'hl\.bind\("([^"]+)",\s*hl\.dsp\.layout\("([^"]+)"\)', block):
    if m.group(2) in ids:
        keys[ids[m.group(2)]] = m.group(1)

open(path, "w").write(text[:start] + open(include).read() + text[end:])
print(json.dumps(keys))
PY
)
    if [[ -x "$tool" && -n "$keys_json" && "$keys_json" != "{}" ]]; then
        INFINITY_HYPRLAND_CONFIG_DIR="$DEST" "$tool" --init >/dev/null 2>&1 || true
        INFINITY_HYPRLAND_CONFIG_DIR="$DEST" "$tool" --set binds.keys "$keys_json" >/dev/null 2>&1 || true
    fi
    init_settings
    say "Конфиг переведён на настройки Infinity. Ваши клавиши перенесены в settings.json, резервная копия: $bak"
}

cmd_status() {
    local m; if m=$(main_config "$DEST"); then echo "Конфиг: $m"; else echo "Конфига нет ($DEST)"; fi
    [[ -d "$src" ]] && echo "Оригинал Hyprland: $src (не изменяется)" || true
}

cmd="${1:-status}"; shift || true
while (($#)); do
    case "$1" in
        --force) force=1 ;;
        --quiet) quiet=1 ;;
        --from) src="${2:?--from требует путь}"; shift ;;
        *) die "неизвестный аргумент: $1" ;;
    esac
    shift
done

case "$cmd" in
    fresh) cmd_fresh ;;
    copy-hyprland) cmd_copy ;;
    migrate) cmd_migrate ;;
    status) cmd_status ;;
    *) die "команды: fresh, copy-hyprland, migrate, status" ;;
esac
